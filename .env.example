# ── LLM (ADR-002) ─────────────────────────────────────────────────────────────
# Le provider est abstrait : OpenAI en développement, Azure OpenAI EU en cible.
PAWRISE_LLM_PROVIDER=openai
PAWRISE_OPENAI_API_KEY=
# PAWRISE_AZURE_OPENAI_ENDPOINT=
# PAWRISE_AZURE_OPENAI_API_KEY=

# ── Reranking (ADR-003) ───────────────────────────────────────────────────────
PAWRISE_COHERE_API_KEY=

# ── Données (conception §5.2) ─────────────────────────────────────────────────
PAWRISE_DATABASE_URL=postgresql://pawrise:pawrise@localhost:5432/pawrise_assistant

# ── Core API (ADR-004) ────────────────────────────────────────────────────────
# En développement : le faux Core API du lot 1.
PAWRISE_CORE_API_URL=http://localhost:8081
PAWRISE_CORE_API_TIMEOUT_MS=200

# ── Audit (ADR-010) ───────────────────────────────────────────────────────────
PAWRISE_AUDIT_SINK=jsonl
PAWRISE_AUDIT_PATH=./audit
